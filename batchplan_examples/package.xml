<?xml version="1.0"?>
<package format="3">
  <name>batchplan_examples</name>
  <version>0.1.0</version>
  <description>Demos of batchplan_ros: a simulated Panda planned from a browser.</description>
  <maintainer email="341164820+natsuku-lab@users.noreply.github.com">natsuku-lab</maintainer>
  <license>MIT OR Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>batchplan_ros</exec_depend>
  <exec_depend>batchplan_viser</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>moveit_resources_panda_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
